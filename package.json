{
  "name": "zhihu-browser",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @zhihu-browser/extension dev",
    "build": "pnpm --filter @zhihu-browser/extension build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && node scripts/check-doc-examples.mjs && node scripts/check-template.mjs && tsc -p docs/examples/tsconfig.json && node scripts/build-ai-guide.mjs --check",
    "test": "vitest run",
    "e2e": "pnpm --filter @zhihu-browser/extension e2e && pnpm --filter @zhihu-browser/extension e2e:user",
    "build:firefox": "pnpm --filter @zhihu-browser/extension build:firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
