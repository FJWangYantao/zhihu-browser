{
  "name": "@zhihu-browser/extension",
  "version": "0.1.0",
  "private": true,
  "description": "zhihu-browser 浏览器扩展",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "e2e:user": "node e2e/user-plugins.mjs",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "lint:firefox": "web-ext lint -s .output/firefox-mv3"
  },
  "dependencies": {
    "@zhihu-browser/adapter-zhihu": "workspace:*",
    "@zhihu-browser/core": "workspace:*",
    "@zhihu-browser/installer": "workspace:*",
    "@zhihu-browser/plugin-declutter": "workspace:*",
    "@zhihu-browser/plugin-filter": "workspace:*",
    "@zhihu-browser/plugin-hd-images": "workspace:*",
    "@zhihu-browser/plugin-info": "workspace:*",
    "@zhihu-browser/plugin-reader": "workspace:*",
    "@zhihu-browser/plugin-shortcuts": "workspace:*",
    "@zhihu-browser/plugin-theme": "workspace:*",
    "@zhihu-browser/remote": "workspace:*",
    "@zhihu-browser/sdk": "workspace:*",
    "@zhihu-browser/ui": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "web-ext": "^8.0.0",
    "wxt": "^0.21.4"
  }
}
